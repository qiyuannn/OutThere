# Copy to .env.local and fill in values from your Supabase project's API settings.
# Leave blank to run the UI shell without a backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat public SDK keys (never use an sk_ secret key).
# test = development Test Store; store = Apple/Google billing.
EXPO_PUBLIC_REVENUECAT_MODE=test
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Membership support and legal destinations. Support accepts https:// or mailto:.
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Google AdMob Banner Ad Unit IDs (optional - defaults to Google test IDs for development)
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=

