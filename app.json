{
  "expo": {
    "name": "OutThere",
    "slug": "outthere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outthere",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.outthere.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow OutThere to use your location to recommend nearby activities and food."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.outthere.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OutThere to use your location to recommend nearby activities and food."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your OutThere profile and posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-revenuecat",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458783700"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
